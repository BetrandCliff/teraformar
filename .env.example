# cPanel PostgreSQL database connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=CPANEL_DB_USER
DB_PASSWORD=your-database-password
DB_DATABASE=CPANEL_DB_NAME
DB_SSL=false

# Admin sessions. Users and password hashes are stored in the PostgreSQL users table.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional email provider settings
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APPLICATION_EMAIL_TO=

